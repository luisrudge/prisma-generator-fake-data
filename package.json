{
  "name": "prisma-generator-fake-data",
  "description": "The easiest way to generate mock data based on your Prisma models!",
  "version": "0.18.3",
  "main": "dist/generator.js",
  "license": "MIT",
  "bin": {
    "prisma-generator-fake-data": "dist/bin.js"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "scripts": {
    "build": "npx tsc",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@prisma/generator-helper": "^7.10.0",
    "@prisma/internals": "^7.10.0",
    "decimal.js": "^10.6.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.1.0",
    "@types/prettier": "^3.0.0",
    "generate-changelog": "^1.8.0",
    "prettier": "^3.9.9",
    "pretty-quick": "^4.2.2",
    "prisma": "^7.10.0",
    "release-it": "^21.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/luisrudge/prisma-generator-fake-data",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisrudge/prisma-generator-fake-data.git"
  },
  "author": "Luis Rudge <luis@luisrudge.net>",
  "keywords": [
    "prisma",
    "prisma2",
    "generator",
    "fake data",
    "faker-js"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
